{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "fractch",
      "camelcase": "Fractch",
      "title": "FRACTCH",
      "scope": "source.fractch",
      "file-types": [
        "fractch"
      ],
      "injection-regex": "^fractch$",
      "class-name": "TreeSitterFractch",
      "highlights": "queries/fractch/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Fractch grammar for tree-sitter",
    "authors": [
      {
        "name": "grady.link",
        "email": "tree-sitter@grady.link",
        "url": "https://grady.link"
      }
    ],
    "links": {
      "repository": "https://github.com/gradylink/tree-sitter-fractch",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
